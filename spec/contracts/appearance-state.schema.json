{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lookswise.dev/schemas/appearance-state.schema.json",
  "title": "LooksWise AppearanceState",
  "type": "object",
  "required": ["id", "version", "subjectId", "regions", "confidence"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "subjectId": {"type": "string"},
    "regions": {"type": "array", "items": {"type": "object", "required": ["regionType", "representationRef", "confidence"], "properties": {"regionType": {"type": "string"}, "representationRef": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sourceMediaRefs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
