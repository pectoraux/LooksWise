{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lookswise.dev/schemas/fidelity.schema.json",
  "title": "LooksWise Fidelity",
  "type": "object",
  "required": ["simulationId", "evidenceTier", "uncertainty", "dimensions"],
  "properties": {
    "simulationId": {"type": "string"},
    "evidenceTier": {"enum": ["T0", "T1", "T2", "T3", "T4", "T5"]},
    "uncertainty": {"type": "object"},
    "dimensions": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "calibrationModelVersion": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
